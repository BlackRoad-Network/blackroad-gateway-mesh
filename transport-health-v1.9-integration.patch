--- a/messaging/tests/mcp.test.mjs
+++ b/messaging/tests/mcp.test.mjs
@@ -322,3 +322,23 @@
+test('MCP exposes read-only transport health probes', async () => {
+  const temp = await mkdtemp(join(tmpdir(), 'road-messaging-health-mcp-'));
+  const child = startMcp(temp);
+  try {
+    const list = await lineRequest(child, { jsonrpc: '2.0', id: 1, method: 'tools/list', params: {} });
+    const names = list.result.tools.map((tool) => tool.name);
+    assert.ok(names.includes('road_messaging_health_probe'));
+    assert.ok(names.includes('road_messaging_health_matrix'));
+    const probe = await lineRequest(child, {
+      jsonrpc: '2.0', id: 2, method: 'tools/call',
+      params: { name: 'road_messaging_health_probe', arguments: { kind: 'dns', target: 'localhost' } },
+    });
+    assert.equal(probe.result.structuredContent.probe, 'dns');
+    assert.equal(probe.result.structuredContent.state, 'RESOLVED');
+  } finally {
+    child.kill('SIGTERM');
+    await rm(temp, { recursive: true, force: true });
+  }
+});
