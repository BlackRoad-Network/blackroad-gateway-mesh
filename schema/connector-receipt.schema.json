{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackroad.io/schemas/connector-receipt.schema.json",
  "title": "BlackRoad Connector Execution Receipt",
  "type": "object",
  "required": ["schema", "connector", "operation", "status", "reason", "inputSha256", "verification", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "road-connector-receipt-v1"},
    "connector": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "operation": {"enum": ["read", "write"]},
    "status": {"enum": ["blocked", "planned", "failed", "succeeded", "unknown"]},
    "reason": {"type": ["string", "null"]},
    "inputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "automaticRetry"],
      "properties": {
        "required": {"const": true},
        "automaticRetry": {"const": false},
        "jobId": {"type": "string", "format": "uuid"}
      }
    },
    "verification": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {"type": "boolean"},
            "detail": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "unknown"}}, "required": ["status"]},
    "then": {"required": ["reconciliation"], "properties": {"operation": {"const": "write"}}}
  }]
}
