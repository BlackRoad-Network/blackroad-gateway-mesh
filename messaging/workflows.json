        {"id":"collect-receipts","actionClass":"READ","owner":"agent-instance-4","dependsOn":[]},
        {"id":"render-draft","actionClass":"WRITE","owner":"agent-instance-5","dependsOn":["collect-receipts"]},
        {"id":"human-review","actionClass":"OBSERVE","owner":"agent-instance-4","dependsOn":["render-draft"]},
        {"id":"post-status","actionClass":"COMMUNICATE","owner":"agent-instance-4","dependsOn":["human-review"],"requiresVerifiedDependencies":true}
      ]
    },
    {
      "id": "mention-to-agent-handoff",
      "integrationOwnerAgent": "agent-instance-4",
      "participants": ["agent-instance-2", "agent-instance-4"],
