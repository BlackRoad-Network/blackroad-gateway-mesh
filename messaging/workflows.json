{
  "schema": "road-conversation-workflow-templates-v1",
  "templates": [
    {
      "id": "discussion-to-work-item",
      "integrationOwnerAgent": "agent-instance-4",
      "participants": ["agent-instance-2", "agent-instance-4"],
      "steps": [
        {"id":"read-thread","actionClass":"READ","owner":"agent-instance-4","dependsOn":[]},
        {"id":"classify","actionClass":"OBSERVE","owner":"agent-instance-2","dependsOn":["read-thread"]},
        {"id":"create-work-item","actionClass":"WRITE","owner":"agent-instance-4","dependsOn":["classify"],"requiresVerifiedDependencies":true},
        {"id":"reply-with-link","actionClass":"COMMUNICATE","owner":"agent-instance-4","dependsOn":["create-work-item"],"requiresVerifiedDependencies":true}
      ]
    },
    {
      "id": "code-review-discussion",
      "integrationOwnerAgent": "agent-instance-4",
      "participants": ["agent-instance-2", "agent-instance-4"],
      "steps": [
        {"id":"read-review-thread","actionClass":"READ","owner":"agent-instance-2","dependsOn":[]},
        {"id":"prepare-change","actionClass":"WRITE","owner":"agent-instance-2","dependsOn":["read-review-thread"]},
        {"id":"verify-change","actionClass":"READ","owner":"agent-instance-2","dependsOn":["prepare-change"]},
        {"id":"reply-review","actionClass":"COMMUNICATE","owner":"agent-instance-4","dependsOn":["verify-change"],"requiresVerifiedDependencies":true}
      ]
    },
    {
      "id": "cross-platform-status-thread",
      "integrationOwnerAgent": "agent-instance-4",
      "participants": ["agent-instance-4", "agent-instance-5"],
