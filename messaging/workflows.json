        {"id":"mention-received","actionClass":"READ","owner":"agent-instance-4","dependsOn":[]},
        {"id":"resolve-agent","actionClass":"READ","owner":"agent-instance-2","dependsOn":["mention-received"]},
        {"id":"create-handoff","actionClass":"WRITE","owner":"agent-instance-4","dependsOn":["resolve-agent"],"requiresVerifiedDependencies":true},
        {"id":"acknowledge-thread","actionClass":"COMMUNICATE","owner":"agent-instance-4","dependsOn":["create-handoff"],"requiresVerifiedDependencies":true}
      ]
