{
  "schema": "road-conversation-contracts-v1",
  "service": {
    "id": "conversations",
    "roadUri": "road://service/conversations",
    "aliases": ["road://messaging", "road://service/messaging"],
    "tailscaleService": "svc:conversations",
    "visibility": "private-by-default",
    "publicGatewayExecution": false,
    "ownerAgent": "agent-instance-4"
  },
  "policy": {
    "contentPlane": "provider-native-or-encrypted-private-store",
    "controlPlane": "road-collaboration-broker",
    "readsMayOverlap": true,
    "draftsRequireClaim": true,
    "externalCommunicationRequiresUserApproval": true,
    "administrationRequiresGovernance": true,
    "providerWritesRequireReadAfterWrite": true,
    "timeoutsRemainUnknown": true,
    "messageContentNeverEntersPublicGatewayMetadata": true,
    "providerSecretsRemainProviderNative": true,
    "automaticCrossPosting": false,
    "maxBridgeHops": 4,
    "ignoreOwnEcho": true,
    "idempotencyRequiredForMutations": true,
    "exactRuntimeSessionBinding": true
  },
  "operations": [
    ["conversation.list", "READ", false, "response"],
    ["conversation.get", "READ", false, "response"],
    ["channel.list", "READ", false, "response"],
    ["channel.read", "READ", false, "response"],
    ["thread.read", "READ", false, "response"],
    ["message.search", "READ", false, "response"],
    ["message.read", "READ", false, "response"],
    ["reaction.list", "READ", false, "response"],
    ["draft.create", "WRITE", false, "read-back"],
    ["draft.update", "WRITE", false, "read-back"],
    ["draft.delete", "WRITE", false, "absence-read-back"],
    ["draft.send", "COMMUNICATE", true, "thread-read-back"],
    ["message.post", "COMMUNICATE", true, "message-read-back"],
    ["message.reply", "COMMUNICATE", true, "thread-read-back"],
    ["message.edit", "COMMUNICATE", true, "message-read-back"],
    ["message.delete", "COMMUNICATE", true, "absence-read-back"],
    ["message.schedule", "COMMUNICATE", true, "scheduled-item-read-back"],
    ["message.stream", "COMMUNICATE", true, "final-message-read-back"],
    ["reaction.add", "COMMUNICATE", true, "reaction-read-back"],
    ["reaction.remove", "COMMUNICATE", true, "reaction-read-back"],
    ["comment.create", "COMMUNICATE", true, "comment-read-back"],
    ["comment.reply", "COMMUNICATE", true, "thread-read-back"],
    ["comment.edit", "COMMUNICATE", true, "comment-read-back"],
    ["comment.delete", "COMMUNICATE", true, "absence-read-back"],
    ["discussion.resolve", "COMMUNICATE", true, "thread-state-read-back"],
    ["discussion.reopen", "COMMUNICATE", true, "thread-state-read-back"],
    ["mention.emit", "COMMUNICATE", true, "message-read-back"],
    ["attachment.upload", "COMMUNICATE", true, "attachment-read-back"],
    ["channel.create", "ADMIN", true, "channel-read-back"],
    ["channel.archive", "ADMIN", true, "channel-state-read-back"],
    ["thread.subscribe", "ADMIN", true, "subscription-read-back"],
    ["thread.unsubscribe", "ADMIN", true, "subscription-read-back"],
    ["webhook.register", "ADMIN", true, "webhook-read-back"]
  ],
  "platforms": [
    {"id":"blackroad","adapter":"native","state":"LOCAL_FIRST","capabilities":"*"},
    {"id":"slack","adapter":"@chat-adapter/slack","state":"READ_VERIFIED_WRITE_TOOL_AVAILABLE","capabilities":["channel.list","channel.read","thread.read","message.search","message.post","message.reply","message.edit","message.delete","message.schedule","draft.create","reaction.list","reaction.add","channel.create","comment.create","comment.reply","attachment.upload"]},
    {"id":"microsoft-teams","adapter":"@chat-adapter/teams","state":"ADAPTER_AVAILABLE_CONFIG_REQUIRED","capabilities":["channel.list","channel.read","thread.read","message.post","message.reply","message.edit","message.delete","reaction.add","attachment.upload","channel.create","webhook.register"]},
    {"id":"google-chat","adapter":"@chat-adapter/gchat","state":"ADAPTER_AVAILABLE_CONFIG_REQUIRED","capabilities":["channel.list","channel.read","thread.read","message.post","message.reply","reaction.add","attachment.upload","webhook.register"]},
