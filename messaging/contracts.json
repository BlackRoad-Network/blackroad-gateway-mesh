    {"id":"telegram","adapter":"@chat-adapter/telegram","state":"ADAPTER_AVAILABLE_CONFIG_REQUIRED","capabilities":["channel.read","thread.read","message.post","message.reply","message.edit","message.delete","attachment.upload","webhook.register"]},
    {"id":"whatsapp","adapter":"@chat-adapter/whatsapp","state":"ADAPTER_AVAILABLE_CONFIG_REQUIRED","capabilities":["thread.read","message.post","message.reply","message.read","attachment.upload","webhook.register"]},
    {"id":"github","adapter":"@chat-adapter/github","state":"WRITE_VERIFIED","capabilities":["conversation.get","thread.read","comment.create","comment.reply","comment.edit","comment.delete","discussion.resolve","discussion.reopen","reaction.list","reaction.add","reaction.remove","message.search"]},
