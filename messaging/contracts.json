    {"id":"zoom-team-chat","adapter":"provider-native","state":"CONNECTOR_PRESENT_CHAT_UNVERIFIED","capabilities":["channel.list","channel.read","thread.read","message.post","message.reply","attachment.upload"]},
    {"id":"matrix","adapter":"@beeper/chat-adapter-matrix","state":"COMMUNITY_ADAPTER_CONFIG_REQUIRED","capabilities":["channel.list","channel.read","thread.read","message.post","message.reply","message.edit","message.delete","reaction.add","reaction.remove","attachment.upload","webhook.register"]}
  ],
  "observedSurfaces": [
