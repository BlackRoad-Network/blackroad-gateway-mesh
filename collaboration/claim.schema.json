{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"road://schema/collaboration-claim/v1",
  "title":"BlackRoad Collaboration Resource Claim",
  "type":"object",
  "required":["id","agentId","resourceKey","mode","state","acquiredAt"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "agentId":{"type":"string","pattern":"^(connector-orchestrator|agent-instance-[1-6])$"},
    "sessionRef":{"type":["string","null"]},
    "intentId":{"type":["string","null"]},
    "connectorId":{"type":["string","null"]},
    "resourceKey":{"type":"string","minLength":1},
    "mode":{"enum":["shared","exclusive"]},
    "actionClass":{"type":["string","null"]},
    "state":{"enum":["ACTIVE","RELEASED","EXPIRED","COMPLETED"]},
    "acquiredAt":{"type":"string","format":"date-time"},
    "updatedAt":{"type":["string","null"],"format":"date-time"},
    "expiresAt":{"type":["string","null"],"format":"date-time"}
  },
  "additionalProperties":false,
  "allOf":[{
    "if":{"properties":{"mode":{"const":"exclusive"}},"required":["mode"]},
    "then":{"required":["sessionRef","intentId"],"properties":{"sessionRef":{"type":"string","minLength":1}}}
  }]
}
