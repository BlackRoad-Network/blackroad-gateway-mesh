{
  "schema":"road-collaboration-workflow-templates-v1",
  "templates":[
    {
      "id":"code-to-public-deploy",
      "integrationOwnerAgent":"agent-instance-4",
      "participants":["agent-instance-2","agent-instance-3","agent-instance-4"],
      "steps":[
        {"id":"source-change","connectorProfile":"source-control","actionClass":"WRITE","owner":"agent-instance-2","dependsOn":[]},
        {"id":"deploy","connectorProfile":"hosting-deploy","actionClass":"DEPLOY","owner":"agent-instance-4","dependsOn":["source-change"],"requiresVerifiedDependencies":true},
        {"id":"public-route","connectorProfile":"domain-routing","actionClass":"PUBLIC_EXPOSE","owner":"agent-instance-3","dependsOn":["deploy"],"requiresVerifiedDependencies":true},
        {"id":"observe","connectorProfile":"observability","actionClass":"READ","owner":"agent-instance-4","dependsOn":["public-route"]},
        {"id":"notify","connectorProfile":"communications","actionClass":"COMMUNICATE","owner":"agent-instance-4","dependsOn":["observe"],"requiresVerifiedDependencies":true}
      ],
      "compensation":[{"for":"public-route","actionClass":"ADMIN","owner":"agent-instance-3","summary":"restore prior verified route target"},{"for":"deploy","actionClass":"DEPLOY","owner":"agent-instance-4","summary":"roll back to prior verified deployment when provider supports it"}]
    },
    {
      "id":"device-to-private-service",
      "integrationOwnerAgent":"agent-instance-4",
      "participants":["agent-instance-1","agent-instance-3","agent-instance-4","agent-instance-6"],
      "steps":[
        {"id":"device-evidence","connectorProfile":"compute-network","actionClass":"READ","owner":"agent-instance-1","dependsOn":[]},
        {"id":"listener-proof","connectorProfile":"local-bridge","actionClass":"READ","owner":"agent-instance-6","dependsOn":["device-evidence"]},
        {"id":"private-service","connectorProfile":"compute-network","actionClass":"ADMIN","owner":"agent-instance-1","dependsOn":["listener-proof"],"requiresVerifiedDependencies":true},
        {"id":"private-resolution","connectorProfile":"domain-routing","actionClass":"WRITE","owner":"agent-instance-3","dependsOn":["private-service"],"requiresVerifiedDependencies":true}
      ]
    },
    {
      "id":"connector-onboarding",
      "integrationOwnerAgent":"agent-instance-4",
      "participants":["agent-instance-4","agent-instance-5"],
      "steps":[
        {"id":"discover","connectorProfile":"internal-service","actionClass":"READ","owner":"agent-instance-4","dependsOn":[]},
        {"id":"secret-reference","connectorProfile":"identity-secrets","actionClass":"SECRET","owner":"agent-instance-4","dependsOn":["discover"]},
        {"id":"provider-health","connectorProfile":"restrictive-unknown","actionClass":"READ","owner":"agent-instance-4","dependsOn":["secret-reference"]},
        {"id":"policy-register","connectorProfile":"internal-service","actionClass":"WRITE","owner":"agent-instance-4","dependsOn":["provider-health"]},
        {"id":"skill-route","connectorProfile":"internal-service","actionClass":"WRITE","owner":"agent-instance-5","dependsOn":["policy-register"]}
      ]
    },
    {
      "id":"email-event-to-task",
      "integrationOwnerAgent":"agent-instance-4",
      "participants":["agent-instance-2","agent-instance-4"],
      "steps":[
        {"id":"receive","connectorProfile":"communications","actionClass":"READ","owner":"agent-instance-4","dependsOn":[]},
        {"id":"classify","connectorProfile":"internal-service","actionClass":"OBSERVE","owner":"agent-instance-2","dependsOn":["receive"]},
        {"id":"task-write","connectorProfile":"productivity-docs","actionClass":"WRITE","owner":"agent-instance-4","dependsOn":["classify"],"requiresVerifiedDependencies":true},
        {"id":"reply","connectorProfile":"communications","actionClass":"COMMUNICATE","owner":"agent-instance-4","dependsOn":["task-write"],"requiresVerifiedDependencies":true}
      ]
    },
    {
      "id":"model-serving",
      "integrationOwnerAgent":"agent-instance-4",
      "participants":["agent-instance-2","agent-instance-4","agent-instance-6"],
      "steps":[
        {"id":"model-resolve","connectorProfile":"ai-model","actionClass":"READ","owner":"agent-instance-4","dependsOn":[]},
        {"id":"runtime-proof","connectorProfile":"compute-network","actionClass":"READ","owner":"agent-instance-6","dependsOn":["model-resolve"]},
        {"id":"serve","connectorProfile":"ai-model","actionClass":"DEPLOY","owner":"agent-instance-4","dependsOn":["runtime-proof"],"requiresVerifiedDependencies":true},
        {"id":"observe","connectorProfile":"observability","actionClass":"READ","owner":"agent-instance-4","dependsOn":["serve"]}
      ],
      "compensation":[{"for":"serve","actionClass":"DEPLOY","owner":"agent-instance-4","summary":"disable or roll back the model endpoint using provider-native rollback when verification fails"}]
    },
    {
      "id":"docs-to-signature",
      "integrationOwnerAgent":"agent-instance-4",
      "participants":["agent-instance-2","agent-instance-4"],
      "steps":[
        {"id":"document-read","connectorProfile":"productivity-docs","actionClass":"READ","owner":"agent-instance-2","dependsOn":[]},
        {"id":"document-write","connectorProfile":"productivity-docs","actionClass":"WRITE","owner":"agent-instance-2","dependsOn":["document-read"]},
        {"id":"signature-send","connectorProfile":"productivity-docs","actionClass":"COMMUNICATE","owner":"agent-instance-4","dependsOn":["document-write"],"requiresVerifiedDependencies":true},
        {"id":"signature-status","connectorProfile":"productivity-docs","actionClass":"READ","owner":"agent-instance-4","dependsOn":["signature-send"]}
      ]
    }
  ]
}
