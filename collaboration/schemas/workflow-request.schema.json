{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "road://schema/collaboration/workflow-request/v1",
  "title": "BlackRoad Connector Workflow Request",
  "type": "object",
  "required": ["schema", "workflowId", "agentId", "steps"],
  "properties": {
    "schema": {"const": "road-connector-workflow-request-v1"},
    "workflowId": {"type": "string", "minLength": 1},
    "agentId": {"type": "string", "pattern": "^agent-instance-[1-6]$"},
    "correlationId": {"type": "string"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "connector", "target", "operation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "agentId": {"type": "string", "pattern": "^agent-instance-[1-6]$"},
          "connector": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "mode": {"enum": ["read", "write", "admin"]},
          "dependsOn": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "idempotencyKey": {"type": "string"},
          "expectedVersion": {"type": "string"},
          "decisionReceiptRef": {"type": "string"},
          "delegationRef": {"type": "string"},
          "payloadRef": {"type": "string"},
          "secretRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
