{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "road://schema/collaboration/workflow-plan/v1",
  "title": "BlackRoad Connector Workflow Plan",
  "type": "object",
  "required": ["schema", "workflowId", "correlationId", "steps", "waves", "handoffs", "blockedSteps", "canExecute", "completionRule", "retryRule", "planHash"],
  "properties": {
    "schema": {"const": "road-connector-workflow-plan-v1"},
    "workflowId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "dispatchPlan"]}},
    "waves": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "handoffs": {"type": "array", "items": {"type": "object"}},
    "blockedSteps": {"type": "array", "items": {"type": "object"}},
    "canExecute": {"type": "boolean"},
    "planHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
